# Razer BlackShark V3 X HyperSpeed (Xbox) udev rule
#
# Installation:
#   sudo cp 99-blackshark.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# This rule grants non-root access to the hidraw device so the user-level
# blacksharkd service can access it without sudo.
#
# The `users` group is broadly available on modern Linux distributions. The
# uaccess tag additionally grants access to the active desktop-session user.

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0a5b", MODE="0660", GROUP="users", TAG+="uaccess"
